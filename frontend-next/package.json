{
  "name": "aggipay-frontend-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "npm run generate:types && next build",
    "start": "next start -p 3001",
    "generate:types": "swagger-typescript-api generate --path ../docs/swagger.json --output ./src/generated --name api.ts --extract-request-params --extract-response-body"
  },
  "dependencies": {
    "next": "15.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "swagger-typescript-api": "^13.3.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  }
}
